CANDLE_TIMEFRAME_MS=60000
OPTION_CHAIN_REFRESH_MS=3500
DEPTH_MAX_INSTRUMENTS=50

# Dhan v2 binary header reference used by decoder:
# Byte 0 = response code
# Byte 1-2 = message length (little-endian)
# Byte 3 = exchange segment
# Byte 4-7 = security ID (little-endian uint32)
